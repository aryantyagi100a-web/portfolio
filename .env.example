# Copy this file to .env and fill in real values.

# Password required to read submissions at /admin and GET /api/messages
ADMIN_PASSWORD=change-me

# Port for the API server (frontend dev proxy targets 3001)
PORT=3001

# --- Email notifications (optional) ---
# If both are set, every contact submission is emailed to you via Gmail SMTP.
# Use a Google "App Password" (account must have 2-step verification on):
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd abcd abcd abcd

# Where notifications are sent (defaults to GMAIL_USER if empty)
NOTIFY_EMAIL=

# --- WhatsApp notifications (optional, via free CallMeBot API) ---
# 1. Save this number: +34 644 51 95 23 (CallMeBot)
# 2. Send it this exact message: "I allow callmebot to send me messages"
# 3. It replies with an API key — paste it below.
# Phone = your WhatsApp number, digits only (country code, no + or spaces)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
